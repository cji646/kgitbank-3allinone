[ 1. DNS 설정 ( Domain Name : kgitbank.com ) / (Host Name: www(200) ]  

# dnf -y install bind  [ 패키지 설치 ]
============================================================
# vi /etc/named.conf  

11         listen-on port 53 { any; };  
19         allow-query     { any; };  
31         recursion no;  
============================================================
# vi /etc/named.rfc1912.zones  

zone "kgitbank.com" IN {  

        type master;  

        file "kgitbank.zone";  

};  
# 해당 문서 최하단에 위 내용 추가로 작성  
============================================================
# cd /var/named ( 이동 ) 

# cp named.localhost kgitbank.zone ( 복사 ) 

# chmod 640 kgitbank.zone  ( 권한 변경 )

# chown .named kgitbank.zone ( 소유권 변경 )  

# ls -l kgitbank.zone ( 리스트 확인 )  

-rw-r----- 1 root named 152  8월  6 15:13 kgitbank.zone  
============================================================
[ named 안에 존 파일 수정 ]
# vi kgitbank.zone  

$TTL 1D
@       IN SOA  ns1.kgitbank.com.       root(
                                        20260828        ; serial
                                        60      ; refresh
                                        1H      ; retry
                                        1W      ; expire
                                        3H )    ; minimum
        IN      NS      ns1.kgitbank.com.
ns1     IN      A       40.40.6.2
www     IN      A       40.40.2.2  
============================================================
